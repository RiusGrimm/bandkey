#!/usr/bin/env python3
"""JX-11 Bluetooth Ring Key Remapper for Linux.

Grabs all evdev nodes belonging to the JX-11 ring, discards their default
events, and emits synthetic keyboard events via uinput according to a TOML
configuration file.

Physical controls (from sniffer output):
  event20 — Consumer Control (discrete buttons)
    KEY_VOLUMEDOWN  → center_button (center button, default: volume down)
    KEY_VOLUMEUP    → select_button (other select button)
  event21 — Digitizer / scroll wheel surface
    Y decreases     → scroll_up
    Y increases     → scroll_down
    X decreases     → button_left
    X increases     → button_right
    no movement     → button_center (tap the center of the wheel)
"""
import os
import select
import struct
import sys
import time

# ---------------------------------------------------------------------------
# Optional python-evdev
# ---------------------------------------------------------------------------
try:
    import evdev
    from evdev import ecodes, UInput
    _HAS_EVDEV = True
except ImportError:
    _HAS_EVDEV = False

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------
CONFIG_PATH = os.path.expanduser("~/.config/jx11-remapper/config.toml")

DEFAULT_CONFIG = '''\
# JX-11 Ring Remapper Configuration
# Restart the daemon after editing this file.

[device]
name = "JX-11"
mac  = "52:f8:0e:22:06:f2"

[gestures]
# Scroll wheel (event21)
scroll_up    = "XF86AudioRaiseVolume"
scroll_down  = "XF86AudioLowerVolume"

# Directional presses on the wheel (event21)
button_left  = "XF86AudioPrev"
button_right = "XF86AudioNext"

# Center tap on the wheel (event21)
button_center = "XF86AudioPlay"

# Discrete buttons (event20 consumer control)
center_button = "XF86AudioMute"   # Center button (default: KEY_VOLUMEDOWN)
select_button = ""                # Other select button (default: KEY_VOLUMEUP)
'''

# ---------------------------------------------------------------------------
# evdev constants (pure-Python path)
# ---------------------------------------------------------------------------
EVENT_FORMAT = "llHHi"
EVENT_SIZE = struct.calcsize(EVENT_FORMAT)

EV_SYN = 0x00
EV_KEY = 0x01
EV_ABS = 0x03

EVIOCGRAB = 0x40044590

KEY_VOLUMEDOWN = 114
KEY_VOLUMEUP   = 115
BTN_TOUCH = 330

ABS_X = 0
ABS_Y = 1
ABS_MT_POSITION_X = 53
ABS_MT_POSITION_Y = 54
ABS_MT_TRACKING_ID = 57

